{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "JOL Memory Analyser: scan project",
      "type": "shell",
      "command": "mvn -q compile exec:java -Dexec.mainClass=com.asraf.jol.ProjectScanner",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "JOL Memory Analyser: scan active Java file",
      "type": "shell",
      "command": "mvn -q compile exec:java -Dexec.mainClass=com.asraf.jol.ProjectScanner -Dexec.args=\"--file ${file}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
